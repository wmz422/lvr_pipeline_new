          "class_path": "reconstruction_experiment.runtime.RunAudit"
        },
        {
          "class_path": "lvr.training.audit.HostMemoryAudit"
        },
        {
          "class_path": "reconstruction_experiment.audit.NoDescriptionAudit"
        }
