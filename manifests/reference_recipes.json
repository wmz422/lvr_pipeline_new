      "gradient_checkpointing": true,
      "seed": 42,
      "train_qa": true,
      "gaussian": false,
      "qa_loss_weight": 1.0,
      "description_weight": 0.0,
      "encoder_uses_question": false,
      "encoder_includes_original": true,
