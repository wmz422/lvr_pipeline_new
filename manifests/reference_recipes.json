      "use_distributed_sampler": false,
      "plugins": [
        {
          "class_path": "reconstruction_experiment.precision.FlowDeepSpeedPrecision",
          "init_args": {
            "precision": "bf16-mixed",
            "reference_accumulation": 16
          }
        }
      ]
