      "weight_decay": 0.01,
      "lr_schedule_steps": 1346,
      "encoder_type": "qwen",
      "reconstruction_weight": 0.0,
      "flow_model_path": "${REPO}/doc/flow_reconstruction_parallel_20261015/weights/FLUX.2-klein-base-4B",
