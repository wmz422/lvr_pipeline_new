            "filename": "recovery-{step:06d}",
            "every_n_train_steps": 400,
            "save_top_k": 1,
            "save_last": false,
            "save_on_train_epoch_end": false,
            "auto_insert_metric_name": false,
            "dirpath": "${OUTPUT}/teacher_joint/checkpoints"
