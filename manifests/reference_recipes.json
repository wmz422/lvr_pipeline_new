  "teacher_joint": {
    "seed_everything": 42,
    "trainer": {
      "accelerator": "gpu",
      "devices": 4,
      "precision": null,
      "max_epochs": 1,
      "max_steps": 1346,
      "accumulate_grad_batches": 4,
      "gradient_clip_val": 1.0,
